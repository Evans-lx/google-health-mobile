PORT=3000
PUBLIC_URL=https://health.example.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=64-hex-characters
# openssl rand -base64 32
SERVICE_TOKEN=a-long-random-token-for-chatgpt-and-mcp
# openssl rand -base64 32
# Also used as the personal connection key on the ChatGPT MCP authorization page.
SETUP_TOKEN=a-separate-personal-connection-key
DATA_DIR=/app/data
# 免费部署时设置 Neon PostgreSQL 连接串；配置后 OAuth token 不依赖本地磁盘
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
